{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "runtime": "V2",
    "numReplicas": 1,
    "sleepApplication": false,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  },
  "env": {
    "OLLAMA_MODEL": {
      "value": "llama3.2:1b"
    },
    "OLLAMA_BASE_URL": {
      "value": "http://localhost:11434"
    },
    "PORT": {
      "value": "8080"
    }
  }
}
